<ResourceDictionary
    x:Class="AndreasBehrend.NINA.Phd2Api.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="PHD2 API_Options">
        <StackPanel x:Name="RootPanel" Orientation="Vertical" Margin="5">

            <GroupBox Header="API Server" Margin="0,0,0,8">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="API Enabled" Margin="0,4" />
                    <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ApiEnabled}" Margin="4,4" />
                </Grid>
            </GroupBox>

            <GroupBox Header="PHD2 Connection" Margin="0,0,0,8">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="PHD2 Host" Margin="0,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" MinWidth="120" Text="{Binding Phd2Host}" Margin="4,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="PHD2 Port" Margin="0,4" />
                    <TextBox Grid.Row="1" Grid.Column="1" MinWidth="80" Text="{Binding Phd2Port}" Margin="4,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Status" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Phd2ConnectionStatus}" Margin="4,4" FontWeight="SemiBold" />
                </Grid>
            </GroupBox>

            <GroupBox Header="API Network Addresses" Margin="0,0,0,8">
                <StackPanel Margin="5">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="API Port" Margin="0,4" />
                        <TextBox Grid.Column="1" MinWidth="80" HorizontalAlignment="Left" Text="{Binding ApiPort}" Margin="4,4" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ApiEndpoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF" Padding="0,4" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="REST Base URL" Margin="0,2" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="4,2">
                                            <Hyperlink Command="{Binding DataContext.OpenUrlCommand, ElementName=RootPanel}"
                                                       CommandParameter="{Binding RestUrl}">
                                                <TextBlock Text="{Binding RestUrl}" />
                                            </Hyperlink>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="WebSocket URL" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding WebSocketUrl}" Margin="4,2" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Swagger UI" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="4,2">
                                            <Hyperlink Command="{Binding DataContext.OpenUrlCommand, ElementName=RootPanel}"
                                                       CommandParameter="{Binding SwaggerUrl}">
                                                <TextBlock Text="{Binding SwaggerUrl}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Current State">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="PHD2 App State" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CurrentAppState}" Margin="4,4" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="WebSocket Clients" Margin="0,4" />
                </Grid>
            </GroupBox>

            <Button Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    MinWidth="150"
                    Padding="12,4"
                    Command="{Binding RestartCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="Apply &amp; Restart" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRestarting}" Value="True">
                                <Setter Property="Content" Value="Restarting…" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
